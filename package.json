{
  "name": "tabletop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run typecheck && npm test && npm run build && wrangler deploy"
  },
  "dependencies": {
    "konva": "^10.7.0",
    "lucide-preact": "^1.48.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
