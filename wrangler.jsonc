{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // One front door: the custom domain. The workers.dev hostname would be a
  // second public address for the same app that nobody is watching.
  "workers_dev": false,
  "routes": [{ "pattern": "table.parhome.ca", "custom_domain": true }],

  // The client is a single-page app. Every request reaches the Worker first, so it
  // can send plain-HTTP visitors to HTTPS; it answers /api/ itself and passes the
  // rest to the static files (index.html for a room URL such as /r/abc123), except that a
  // missing file under /assets/ is a 404 that isn't cached (src/worker/staticFiles.ts).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      // One object per room: holds the board state and every live WebSocket.
      { "name": "ROOMS", "class_name": "Room" },
      // One object in total: the GM's room list, login throttling, and the
      // random key sessions are signed with.
      { "name": "DIRECTORY", "class_name": "Directory" },
      // One object in total: the table's voice chat, shared by every room.
      { "name": "VOICE", "class_name": "VoiceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["VoiceHub"] }
  ],

  // Uploaded map and token images. Keys are rooms/<roomId>/<assetId>.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tabletop-files" }],

  "observability": { "enabled": true }
}
