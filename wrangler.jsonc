{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // Nothing here says where a table is served, or anything else that is one table's own: that
  // goes in local.jsonc, which is never committed and is laid over this file whenever the app is
  // built (local.example.jsonc shows how; `npm run deploy` won't go without it). With no address
  // given there, a table is served at its account's workers.dev address.

  // The client is a single-page app. Every request reaches the Worker first, so it
  // can send plain-HTTP visitors to HTTPS; it answers /api/ itself and passes the
  // rest to the static files (index.html for a room URL such as /r/abc123), except that a
  // missing file under /assets/ is a 404 that isn't cached (src/worker/staticFiles.ts).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      // One object per room: holds the board state and every live WebSocket.
      { "name": "ROOMS", "class_name": "Room" },
      // One object in total: the GM's room list, login throttling, and the
      // random key sessions are signed with.
      { "name": "DIRECTORY", "class_name": "Directory" },
      // One object in total: the table's voice chat, shared by every room.
      { "name": "VOICE", "class_name": "VoiceHub" },
      // One object in total: the nightly backup into the GM's Google Drive, a little at a time.
      { "name": "BACKUP_JOB", "class_name": "BackupJob" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["VoiceHub"] },
    { "tag": "v3", "new_sqlite_classes": ["BackupJob"] }
  ],

  // Uploaded map and token images. Keys are rooms/<roomId>/<assetId>.
  // (A table with a Dungeon also binds Dungeon's bucket of maps, as DUNGEON_MAPS, in local.jsonc:
  // only for backing them up and putting them back.)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tabletop-files" }],

  // The nightly backup into the GM's Google Drive (backupJob.ts), at 07:30 UTC.
  "triggers": { "crons": ["30 7 * * *"] },

  "observability": { "enabled": true }
}
